{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "structura",
  "main": "src/worker/index.js",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "redgum.theradicalparty.com", "custom_domain": true },
    { "pattern": "structura.theradicalparty.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "structura",
      "database_id": "dbc851e1-e787-404e-ac50-63eb57a81e3f",
      "migrations_dir": "migrations"
    }
  ]
  // ANTHROPIC_API_KEY is set via: wrangler secret put ANTHROPIC_API_KEY
}
